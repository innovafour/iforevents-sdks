{
  "name": "@iforevents/ga4",
  "version": "0.1.0",
  "description": "Google Analytics 4 (gtag.js) adapter for the IForevents SDK",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/innovafour/iforevents-js.git",
    "directory": "packages/ga4"
  },
  "homepage": "https://iforevents.com/docs/sdks/javascript#adapters",
  "keywords": [
    "iforevents",
    "analytics",
    "ga4",
    "integration"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/browser.ts --format esm,cjs --dts --clean --target es2020 --external @iforevents/core",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@iforevents/core": "workspace:^"
  }
}
