{
  "name": "@iforevents/core",
  "version": "0.1.0",
  "description": "IForevents analytics SDK core: facade, pluggable integrations and the first-party API integration with batching, offline queue and retries",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/innovafour/iforevents-js.git", "directory": "packages/core" },
  "homepage": "https://iforevents.com/docs/sdks/javascript",
  "keywords": ["iforevents", "analytics", "events", "tracking", "product-analytics"],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --target es2020",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "engines": { "node": ">=18" }
}
