{
  "name": "@iforevents/posthog",
  "version": "0.1.0",
  "description": "PostHog adapter for the IForevents SDK (browser and Node.js)",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/innovafour/iforevents-js.git", "directory": "packages/posthog" },
  "homepage": "https://iforevents.com/docs/sdks/javascript#adapters",
  "keywords": ["iforevents", "analytics", "posthog", "integration"],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" },
    "./browser": { "types": "./dist/browser.d.ts", "import": "./dist/browser.js", "require": "./dist/browser.cjs" },
    "./node": { "types": "./dist/node.d.ts", "import": "./dist/node.js", "require": "./dist/node.cjs" }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup src/index.ts src/browser.ts src/node.ts --format esm,cjs --dts --clean --target es2020 --external @iforevents/core --external posthog-js --external posthog-node",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": { "@iforevents/core": "workspace:^" },
  "peerDependencies": { "posthog-js": ">=1.100.0", "posthog-node": ">=4.0.0" },
  "peerDependenciesMeta": { "posthog-js": { "optional": true }, "posthog-node": { "optional": true } }
}
