{
  "name": "@iforevents/next",
  "version": "0.1.0",
  "description": "Next.js bindings for the IForevents analytics SDK: App Router provider with automatic page views, plus a server-side client for route handlers and server actions",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/innovafour/iforevents-js.git", "directory": "packages/next" },
  "homepage": "https://iforevents.com/docs/sdks/nextjs",
  "keywords": ["iforevents", "analytics", "nextjs", "react", "app-router"],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" },
    "./server": { "types": "./dist/server.d.ts", "import": "./dist/server.js", "require": "./dist/server.cjs" }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup src/index.tsx src/server.ts --format esm,cjs --dts --clean --target es2020 --external react --external next --external next/navigation --external @iforevents/core --external @iforevents/browser --external @iforevents/react --external @iforevents/node",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": { "@iforevents/browser": "workspace:^", "@iforevents/core": "workspace:^", "@iforevents/node": "workspace:^", "@iforevents/react": "workspace:^" },
  "peerDependencies": { "next": ">=13.4", "react": ">=18" },
  "devDependencies": { "@testing-library/react": "^16.1.0", "@types/react": "^19.0.0", "jsdom": "^26.0.0", "react": "^19.0.0", "react-dom": "^19.0.0" }
}
