{
  "name": "@iforevents/react-native",
  "version": "0.1.0",
  "description": "IForevents analytics SDK for React Native: device context, AsyncStorage queue, background flush, react-navigation screen tracking",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/innovafour/iforevents-js.git", "directory": "packages/react-native" },
  "homepage": "https://iforevents.com/docs/sdks/react-native",
  "keywords": ["iforevents", "analytics", "react-native", "expo", "events"],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "react-native": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" } },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --target es2020 --external react --external react-native --external @react-native-async-storage/async-storage --external react-native-device-info --external @iforevents/core",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": { "@iforevents/core": "workspace:^" },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": ">=1.17.0",
    "react": ">=17",
    "react-native": ">=0.70",
    "react-native-device-info": ">=10.0.0"
  },
  "peerDependenciesMeta": {
    "@react-native-async-storage/async-storage": { "optional": true },
    "react-native-device-info": { "optional": true }
  },
  "devDependencies": { "@types/react": "^19.0.0", "react": "^19.0.0" }
}
