{
  "name": "iforevents-js",
  "private": true,
  "version": "0.1.0",
  "description": "IForevents SDKs for JavaScript: core, browser, node, react, next, react-native and vendor adapters",
  "license": "MIT",
  "repository": "github:innovafour/iforevents-js",
  "packageManager": "pnpm@11.9.0",
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
    "test": "pnpm -r --filter './packages/**' test",
    "typecheck": "pnpm -r --filter './packages/**' typecheck",
    "clean": "pnpm -r --filter './packages/**' exec rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
