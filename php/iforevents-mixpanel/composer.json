{
  "name": "innovafour/iforevents-mixpanel",
  "description": "Mixpanel adapter for the IForevents analytics SDK",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "iforevents",
    "analytics",
    "mixpanel"
  ],
  "homepage": "https://iforevents.com/docs/sdks/php",
  "authors": [
    {
      "name": "Innovafour"
    }
  ],
  "require": {
    "php": ">=8.1",
    "innovafour/iforevents": "^0.1",
    "mixpanel/mixpanel-php": "^2.11"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../iforevents",
      "options": {
        "symlink": true,
        "versions": {
          "innovafour/iforevents": "0.1.0"
        }
      }
    }
  ],
  "autoload": {
    "psr-4": {
      "IForevents\\Integrations\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "IForevents\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --colors=always"
  },
  "config": {
    "sort-packages": true
  }
}
